#!/usr/bin/env node
import { readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const sources = {
	tinyfish: { path: join(homedir(), ".tinyfish", "config.json"), field: "api_key" },
	firecrawl: { path: join(homedir(), ".config", "firecrawl-cli", "credentials.json"), field: "apiKey" },
};

const provider = process.argv[2];
if (!Object.hasOwn(sources, provider)) {
	process.stderr.write("usage: web-access-credential <tinyfish|firecrawl>\n");
	process.exit(2);
}
const source = sources[provider];

try {
	const parsed = JSON.parse(readFileSync(source.path, "utf8"));
	const credential = parsed?.[source.field];
	if (typeof credential !== "string" || !credential.trim() || /[\0-\x1f\x7f]/.test(credential.trim())) {
		throw new Error("credential field is missing or invalid");
	}
	process.stdout.write(credential.trim());
} catch {
	process.stderr.write(`Could not load ${provider} CLI credentials from ${source.path}.\n`);
	process.exit(1);
}
